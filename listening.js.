
const listeningList = document.getElementById("listening-list");

async function loadListeningLessons() {
  if (!listeningList) return;

  try {
    const response = await fetch("./audio-index.json");

    if (!response.ok) {
      throw new Error("Could not load audio-index.json");
    }

    const data = await response.json();
    const lessons = data.sentences || [];

    listeningList.innerHTML = "";

    lessons.forEach((item, index) => {
      const lesson = document.createElement("div");
      lesson.className = "resource";

      const info = document.createElement("div");
      const title = document.createElement("strong");
      title.textContent = `Listening Lesson ${index + 1}`;

      const sentence = document.createElement("p");
      sentence.textContent = item.sentence;

      info.append(title, sentence);

      const audio = document.createElement("audio");
      audio.controls = true;
      audio.preload = "none";
      audio.src = item.audio;

      lesson.append(info, audio);
      listeningList.appendChild(lesson);
    });

  } catch (error) {
    console.error(error);
    listeningList.textContent =
      "Sorry, listening lessons could not be loaded.";
  }
}

loadListeningLessons();
